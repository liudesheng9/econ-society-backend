# Redis LRU Configuration Examples
# Copy these settings to your .env file to enable LRU policies

# Enable automatic Redis LRU configuration
ENABLE_REDIS_LRU_CONFIG=true

# Maximum memory usage for Redis (adjust based on your server capacity)
# Examples: 64mb, 256mb, 512mb, 1gb, 2gb
REDIS_MAXMEMORY=256mb

# Redis eviction policy when maxmemory is reached
# Options:
#   allkeys-lru    - Evict any key using LRU algorithm (recommended for cache)
#   volatile-lru   - Evict only keys with expiration using LRU algorithm
#   allkeys-lfu    - Evict any key using LFU algorithm (Redis 4.0+)
#   volatile-lfu   - Evict only keys with expiration using LFU algorithm
#   allkeys-random - Evict any key randomly
#   volatile-random- Evict keys with expiration randomly
#   volatile-ttl   - Evict keys with expiration, preferring shorter TTL
#   noeviction     - Return error when memory limit is reached
REDIS_EVICTION_POLICY=allkeys-lru

# Number of keys to sample when picking keys to evict
# Higher values = more accurate LRU but slightly slower
# Lower values = faster eviction but less accurate LRU
# Default: 5, Range: 1-10
REDIS_LRU_SAMPLES=5

# Environment-specific configurations:

# Development Environment
# REDIS_MAXMEMORY=64mb
# REDIS_EVICTION_POLICY=allkeys-lru
# REDIS_LRU_SAMPLES=3

# Production Environment
# REDIS_MAXMEMORY=1gb
# REDIS_EVICTION_POLICY=volatile-lru
# REDIS_LRU_SAMPLES=10

# High-Performance Environment
# REDIS_MAXMEMORY=2gb
# REDIS_EVICTION_POLICY=allkeys-lfu
# REDIS_LRU_SAMPLES=5 